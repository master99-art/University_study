 203:Core/Src/motor.c **** u8 Reset_joint(void)
 204:Core/Src/motor.c **** {
 205:Core/Src/motor.c **** 	// joint1->joint6
 206:Core/Src/motor.c **** 	// hand is completely open
 207:Core/Src/motor.c **** 	// first we move joint1 without stopping,then one by one
 208:Core/Src/motor.c **** 
 209:Core/Src/motor.c **** 	Dir_Set(DIR1_GPIO_Port, DIR1_Pin, (GPIO_PinState)joint1.dir);
 210:Core/Src/motor.c **** 	Dir_Set(DIR2_GPIO_Port, DIR2_Pin, (GPIO_PinState)joint2.dir);
 211:Core/Src/motor.c **** 	Dir_Set(DIR3_GPIO_Port, DIR3_Pin, (GPIO_PinState)joint3.dir);
 212:Core/Src/motor.c **** 	Dir_Set(DIR4_GPIO_Port, DIR4_Pin, (GPIO_PinState)joint4.dir);
 213:Core/Src/motor.c **** 	Dir_Set(DIR5_GPIO_Port, DIR5_Pin, (GPIO_PinState)joint5.dir);
 214:Core/Src/motor.c **** 	Dir_Set(DIR6_GPIO_Port, DIR6_Pin, (GPIO_PinState)joint6.dir);
 215:Core/Src/motor.c **** 
 216:Core/Src/motor.c **** 	int step = 1;
 217:Core/Src/motor.c **** 
 218:Core/Src/motor.c **** 	while (1)
 219:Core/Src/motor.c **** 	{
 220:Core/Src/motor.c **** 
 221:Core/Src/motor.c **** 		Motor_Action(joint1_GPIO_Port, joint1_Pin, step);
 222:Core/Src/motor.c **** 		if (Read_KEY(K1_GPIO_Port, K1_Pin) == GPIO_PIN_RESET)
 223:Core/Src/motor.c **** 		{
 224:Core/Src/motor.c **** 
 225:Core/Src/motor.c **** 			joint1.isreset = Reset;
 226:Core/Src/motor.c **** 			break;
 227:Core/Src/motor.c **** 		}
 228:Core/Src/motor.c **** 	}
 229:Core/Src/motor.c **** 	joint1.dir = Reverse;
 230:Core/Src/motor.c **** 	Dir_Set(DIR1_GPIO_Port, DIR1_Pin, (GPIO_PinState)joint1.dir);
 231:Core/Src/motor.c **** 	Motor_Action(joint1_GPIO_Port, joint1_Pin, 4700);
 232:Core/Src/motor.c **** 	joint1.dir = Forward;
ARM GAS  D:\software\msy64\tmp\ccx545Z9.s 			page 19


