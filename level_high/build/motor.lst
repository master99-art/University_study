 284:Core/Src/motor.c **** 	Motor_Action(joint2_GPIO_Port, joint2_Pin, *(step+1));
 285:Core/Src/motor.c **** 	Motor_Action(joint3_GPIO_Port, joint3_Pin, *(step+2));
 286:Core/Src/motor.c **** 	Motor_Action(joint4_GPIO_Port, joint4_Pin, *(step+3));
 287:Core/Src/motor.c **** 	Motor_Action(joint5_GPIO_Port, joint5_Pin, *(step+4));
 288:Core/Src/motor.c **** 	Motor_Action(joint6_GPIO_Port, joint6_Pin, *(step+5));
 289:Core/Src/motor.c **** 	if (hand.action == ON)
 290:Core/Src/motor.c **** 	{
 291:Core/Src/motor.c **** 		// 打开夹爪
 292:Core/Src/motor.c **** 	}
 293:Core/Src/motor.c **** 	else if (hand.action != ON)
 294:Core/Src/motor.c **** 	{
 295:Core/Src/motor.c **** 		// 关闭夹爪
 296:Core/Src/motor.c **** 	}
 297:Core/Src/motor.c **** 	return OK;
 298:Core/Src/motor.c **** }
