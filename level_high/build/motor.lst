 278:Core/Src/motor.c **** // 上层运动控制
 279:Core/Src/motor.c **** u8 Motor_Move(int *step)
 280:Core/Src/motor.c **** {
 281:Core/Src/motor.c **** 	Motor_Action(joint1_GPIO_Port, joint1_Pin, *(step + 0));
 282:Core/Src/motor.c **** 	Motor_Action(joint2_GPIO_Port, joint2_Pin, *(step + 1));
 283:Core/Src/motor.c **** 	Motor_Action(joint3_GPIO_Port, joint3_Pin, *(step + 2));
 284:Core/Src/motor.c **** 	Motor_Action(joint4_GPIO_Port, joint4_Pin, *(step + 3));
 285:Core/Src/motor.c **** 	Motor_Action(joint5_GPIO_Port, joint5_Pin, *(step + 4));
 286:Core/Src/motor.c **** 	Motor_Action(joint6_GPIO_Port, joint6_Pin, *(step + 5));
 287:Core/Src/motor.c **** 	if (hand.action == ON)
 288:Core/Src/motor.c **** 	{
 289:Core/Src/motor.c **** 		// 打开夹爪
 290:Core/Src/motor.c **** 	}
 291:Core/Src/motor.c **** 	else if (hand.action != ON)
 292:Core/Src/motor.c **** 	{
 293:Core/Src/motor.c **** 		// 关闭夹爪
 294:Core/Src/motor.c **** 	}
 295:Core/Src/motor.c **** 	return OK;
 296:Core/Src/motor.c **** }
