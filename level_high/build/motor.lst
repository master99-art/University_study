 325:Core/Src/motor.c **** 	Dir_Set(joint5_GPIO_Port, joint5_Pin, (GPIO_PinState)joint5.dir);
 326:Core/Src/motor.c **** 	Dir_Set(joint6_GPIO_Port, joint6_Pin, (GPIO_PinState)joint6.dir);
 327:Core/Src/motor.c **** }
 328:Core/Src/motor.c **** 
 329:Core/Src/motor.c **** // 上层运动控制
 330:Core/Src/motor.c **** u8 Motor_Move(int *step)
 331:Core/Src/motor.c **** {
 332:Core/Src/motor.c **** 	Motor_Action(joint1_GPIO_Port, joint1_Pin, *(step + 0));
 333:Core/Src/motor.c **** 	Motor_Action(joint2_GPIO_Port, joint2_Pin, *(step + 1));
 334:Core/Src/motor.c **** 	Motor_Action(joint3_GPIO_Port, joint3_Pin, *(step + 2));
 335:Core/Src/motor.c **** 	Motor_Action(joint4_GPIO_Port, joint4_Pin, *(step + 3));
 336:Core/Src/motor.c **** 	Motor_Action(joint5_GPIO_Port, joint5_Pin, *(step + 4));
 337:Core/Src/motor.c **** 	Motor_Action(joint6_GPIO_Port, joint6_Pin, *(step + 5));
 338:Core/Src/motor.c **** 	if (hand.action == ON)
 339:Core/Src/motor.c **** 	{
 340:Core/Src/motor.c **** 		// 打开夹爪
 341:Core/Src/motor.c **** 	}
 342:Core/Src/motor.c **** 	else if (hand.action != ON)
 343:Core/Src/motor.c **** 	{
 344:Core/Src/motor.c **** 		// 关闭夹爪
 345:Core/Src/motor.c **** 	}
 346:Core/Src/motor.c **** 	return OK;
 347:Core/Src/motor.c **** }
