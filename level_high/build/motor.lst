 329:Core/Src/motor.c **** 
 330:Core/Src/motor.c **** // 上层运动控制
 331:Core/Src/motor.c **** u8 Motor_Move(int *step)
 332:Core/Src/motor.c **** {
 333:Core/Src/motor.c **** 	Motor_Action(joint1_GPIO_Port, joint1_Pin, *(step + 0));
 334:Core/Src/motor.c **** 	Motor_Action(joint2_GPIO_Port, joint2_Pin, *(step + 1));
 335:Core/Src/motor.c **** 	Motor_Action(joint3_GPIO_Port, joint3_Pin, *(step + 2));
 336:Core/Src/motor.c **** 	Motor_Action(joint4_GPIO_Port, joint4_Pin, *(step + 3));
 337:Core/Src/motor.c **** 	Motor_Action(joint5_GPIO_Port, joint5_Pin, *(step + 4));
 338:Core/Src/motor.c **** 	Motor_Action(joint6_GPIO_Port, joint6_Pin, *(step + 5));
 339:Core/Src/motor.c **** 	if (hand.action == ON)
 340:Core/Src/motor.c **** 	{
 341:Core/Src/motor.c **** 		// 打开夹爪
 342:Core/Src/motor.c **** 	}
 343:Core/Src/motor.c **** 	else if (hand.action != ON)
 344:Core/Src/motor.c **** 	{
 345:Core/Src/motor.c **** 		// 关闭夹爪
 346:Core/Src/motor.c **** 	}
 347:Core/Src/motor.c **** 	return OK;
 348:Core/Src/motor.c **** }
