  62:Core/Src/data_cal.c **** int usartReceiveOneData(u8 *receiveBuff, UART_HandleTypeDef *huart)
  63:Core/Src/data_cal.c **** {
  64:Core/Src/data_cal.c **** 
  65:Core/Src/data_cal.c **** 	unsigned char USART_Receiver = 0;		   // 接收数据
  66:Core/Src/data_cal.c **** 	static unsigned char checkSum = 0;		   // ？
  67:Core/Src/data_cal.c **** 	static unsigned char USARTBufferIndex = 0; // 串口索引
  68:Core/Src/data_cal.c **** 	static short j = 0, k = 0;
  69:Core/Src/data_cal.c **** 	static unsigned char USARTReceiverFront = 0;
  70:Core/Src/data_cal.c **** 	static unsigned char Start_Flag = START; // 一帧数据传送开始标志位
  71:Core/Src/data_cal.c **** 	static short dataLength = 0;
  72:Core/Src/data_cal.c **** 	dataLength = sizeof(receiveBuff) - 6;
  73:Core/Src/data_cal.c **** 	USART_Receiver = receiveBuff[1];
  74:Core/Src/data_cal.c **** 	USARTReceiverFront = receiveBuff[0];
  75:Core/Src/data_cal.c **** 
  76:Core/Src/data_cal.c **** 	// 接收消息头
  77:Core/Src/data_cal.c **** 	if (Start_Flag == START)
  78:Core/Src/data_cal.c **** 	{
  79:Core/Src/data_cal.c **** 		if (USART_Receiver == 0xaa) // buf[1]
  80:Core/Src/data_cal.c **** 		{
  81:Core/Src/data_cal.c **** 			if (USARTReceiverFront == 0x55) // 数据头两位 //buf[0]
  82:Core/Src/data_cal.c **** 			{
  83:Core/Src/data_cal.c **** 				Start_Flag = !START; // 收到数据头，开始接收数据
  84:Core/Src/data_cal.c **** 				// printf("header ok\n");
  85:Core/Src/data_cal.c **** 				receiveBuff[0] = header[0]; // buf[0]
  86:Core/Src/data_cal.c **** 				receiveBuff[1] = header[1]; // buf[1]
ARM GAS  D:\software\msy64\tmp\ccWLTKzh.s 			page 3


  87:Core/Src/data_cal.c **** 				USARTBufferIndex = 0;		// 缓冲区初始化
  88:Core/Src/data_cal.c **** 				checkSum = 0x00;			// 校验和初始化
  89:Core/Src/data_cal.c **** 			}
  90:Core/Src/data_cal.c **** 		}
  91:Core/Src/data_cal.c **** 		else
  92:Core/Src/data_cal.c **** 		{
  93:Core/Src/data_cal.c **** 			USARTReceiverFront = USART_Receiver;
  94:Core/Src/data_cal.c **** 		}
  95:Core/Src/data_cal.c **** 	}
  96:Core/Src/data_cal.c **** 	else
  97:Core/Src/data_cal.c **** 	{
  98:Core/Src/data_cal.c **** 		switch (USARTBufferIndex)
  99:Core/Src/data_cal.c **** 		{
 100:Core/Src/data_cal.c **** 		case 0: // 接收左右轮速度数据的长度
 101:Core/Src/data_cal.c **** 			receiveBuff[2] = USART_Receiver;
 102:Core/Src/data_cal.c **** 			dataLength = receiveBuff[2]; // buf[2]
 103:Core/Src/data_cal.c **** 			USARTBufferIndex++;
 104:Core/Src/data_cal.c **** 			break;
 105:Core/Src/data_cal.c **** 		case 1:									 // 接收所有数据，并赋值处理
 106:Core/Src/data_cal.c **** 			receiveBuff[j + 3] = USART_Receiver; // buf[3] - buf[9]
 107:Core/Src/data_cal.c **** 			j++;
 108:Core/Src/data_cal.c **** 			if (j >= dataLength)
 109:Core/Src/data_cal.c **** 			{
 110:Core/Src/data_cal.c **** 				j = 0;
 111:Core/Src/data_cal.c **** 				USARTBufferIndex++;
 112:Core/Src/data_cal.c **** 			}
 113:Core/Src/data_cal.c **** 			break;
 114:Core/Src/data_cal.c **** 		case 2: // 接收校验值信息
 115:Core/Src/data_cal.c **** 			receiveBuff[3 + dataLength] = USART_Receiver;
 116:Core/Src/data_cal.c **** 			checkSum = getCrc8(receiveBuff, 3 + dataLength);
 117:Core/Src/data_cal.c **** 			// 检查信息校验值
 118:Core/Src/data_cal.c **** 			if (checkSum != receiveBuff[3 + dataLength])
 119:Core/Src/data_cal.c **** 				return 0;
 120:Core/Src/data_cal.c **** 			USARTBufferIndex++;
 121:Core/Src/data_cal.c **** 			break;
 122:Core/Src/data_cal.c **** 
 123:Core/Src/data_cal.c **** 		case 3: // 接收信息尾
 124:Core/Src/data_cal.c **** 			if (k == 0)
 125:Core/Src/data_cal.c **** 			{
 126:Core/Src/data_cal.c **** 				// 数据0d     buf[11]  无需判断
 127:Core/Src/data_cal.c **** 				k++;
 128:Core/Src/data_cal.c **** 			}
 129:Core/Src/data_cal.c **** 			else if (k == 1)
 130:Core/Src/data_cal.c **** 			{
 131:Core/Src/data_cal.c **** 				// 数据0a     buf[12] 无需判断
 132:Core/Src/data_cal.c **** 
 133:Core/Src/data_cal.c **** 				// 进行角度赋值操作
 134:Core/Src/data_cal.c **** 				for (k = 0; k < 2; k++)
 135:Core/Src/data_cal.c **** 				{
 136:Core/Src/data_cal.c **** 					joint1Set.data[k] = receiveBuff[k + 3];
 137:Core/Src/data_cal.c **** 					joint2Set.data[k] = receiveBuff[k + 5];
 138:Core/Src/data_cal.c **** 					joint3Set.data[k] = receiveBuff[k + 7];
 139:Core/Src/data_cal.c **** 					joint4Set.data[k] = receiveBuff[k + 9];
 140:Core/Src/data_cal.c **** 					joint5Set.data[k] = receiveBuff[k + 11];
 141:Core/Src/data_cal.c **** 					joint6Set.data[k] = receiveBuff[k + 13];
 142:Core/Src/data_cal.c **** 				}
 143:Core/Src/data_cal.c **** 
