  94:Core/Src/data_cal.c **** 		}
  95:Core/Src/data_cal.c **** 	}
  96:Core/Src/data_cal.c **** 	if (Start_Flag != START)
  97:Core/Src/data_cal.c **** 	{
  98:Core/Src/data_cal.c **** 		dataLength = receiveBuff[2];
  99:Core/Src/data_cal.c **** 		checkSum = getCrc8(receiveBuff, 3 + dataLength);
 100:Core/Src/data_cal.c **** 		if (checkSum == receiveBuff[3 + dataLength])
 101:Core/Src/data_cal.c **** 		{
 102:Core/Src/data_cal.c **** 			// 进行角度赋值操作
 103:Core/Src/data_cal.c **** 			for (k = 0; k < 2; k++)
 104:Core/Src/data_cal.c **** 			{
 105:Core/Src/data_cal.c **** 				joint1Set.data[k] = receiveBuff[k + 3];
 106:Core/Src/data_cal.c **** 				joint2Set.data[k] = receiveBuff[k + 5];
 107:Core/Src/data_cal.c **** 				joint3Set.data[k] = receiveBuff[k + 7];
 108:Core/Src/data_cal.c **** 				joint4Set.data[k] = receiveBuff[k + 9];
 109:Core/Src/data_cal.c **** 				joint5Set.data[k] = receiveBuff[k + 11];
 110:Core/Src/data_cal.c **** 				joint6Set.data[k] = receiveBuff[k + 13];
 111:Core/Src/data_cal.c **** 			}
 112:Core/Src/data_cal.c **** 
 113:Core/Src/data_cal.c **** 			angleset[0] = -(((float)joint1Set.d) / 1000.0);
 114:Core/Src/data_cal.c **** 			angleset[1] = (((float)joint2Set.d) / 1000.0);
 115:Core/Src/data_cal.c **** 			angleset[2] = (((float)joint3Set.d) / 1000.0);
 116:Core/Src/data_cal.c **** 			angleset[3] = (((float)joint4Set.d) / 1000.0);
 117:Core/Src/data_cal.c **** 			angleset[4] = (((float)joint5Set.d) / 1000.0);
 118:Core/Src/data_cal.c **** 			angleset[5] = (((float)joint6Set.d) / 1000.0);
 119:Core/Src/data_cal.c **** 			angleset[6] = ((float)receiveBuff[15]);
 120:Core/Src/data_cal.c **** 			//-----------------------------------------------------------------
 121:Core/Src/data_cal.c **** 			// 完成一个数据包的接收，相关变量清零，等待下一字节数据
 122:Core/Src/data_cal.c **** 			USARTBufferIndex = 0;
 123:Core/Src/data_cal.c **** 			USARTReceiverFront = 0;
 124:Core/Src/data_cal.c **** 			Start_Flag = START;
 125:Core/Src/data_cal.c **** 			checkSum = 0;
 126:Core/Src/data_cal.c **** 			dataLength = 0;
 127:Core/Src/data_cal.c **** 			j = 0;
 128:Core/Src/data_cal.c **** 			k = 0;
 129:Core/Src/data_cal.c **** 			//-----------------------------------------------------------------
 130:Core/Src/data_cal.c **** 		}
 131:Core/Src/data_cal.c **** 		else
 132:Core/Src/data_cal.c **** 		{
 133:Core/Src/data_cal.c **** 			for (u8 i = 0; i < 19; i++)
 134:Core/Src/data_cal.c **** 				receiveBuff[i] = 0; // 清除接收缓存
 135:Core/Src/data_cal.c **** 			// 校验和错误，清除接收缓存
 136:Core/Src/data_cal.c **** 			USARTBufferIndex = 0;
 137:Core/Src/data_cal.c **** 			USARTReceiverFront = 0;
 138:Core/Src/data_cal.c **** 			Start_Flag = START;
 139:Core/Src/data_cal.c **** 			checkSum = 0;
 140:Core/Src/data_cal.c **** 			dataLength = 0;
 141:Core/Src/data_cal.c **** 			j = 0;
 142:Core/Src/data_cal.c **** 			k = 0;
 143:Core/Src/data_cal.c **** 			return 0; // 返回错误
