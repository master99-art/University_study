  16:Core/Src/data_cal.c **** 
  17:Core/Src/data_cal.c **** /*--------------------------------发送协议-----------------------------------
  18:Core/Src/data_cal.c **** //----------------55 aa size 00 00 00 00 00 crc8 0d 0a----------------------
  19:Core/Src/data_cal.c **** //----------------55 aa size 00 00 00 00 00 0d 0a----------------------
  20:Core/Src/data_cal.c **** //数据头55aa + 数据字节数size + 数据（利用共用体） + 校验crc8 + 数据尾0d0a
  21:Core/Src/data_cal.c **** //注意：这里数据中预留了一个字节的控制位，其他的可以自行扩展，更改s
  22:Core/Src/data_cal.c **** --------------------------------------------------------------------------*/
  23:Core/Src/data_cal.c **** 
  24:Core/Src/data_cal.c **** /*--------------------------------接收协议-----------------------------------
  25:Core/Src/data_cal.c **** //----------------55 aa size 00 00 00 00 00 00 00 crc8 0d 0a----------------
  26:Core/Src/data_cal.c **** //数据头55aa + 数据字节数size + 数据（利用共用体） + 校验crc8 + 数据尾0d0a
  27:Core/Src/data_cal.c **** //注意：这里数据中预留了一个字节的控制位，其他的可以自行扩展，更改s
