  62:Core/Src/data_cal.c **** int usartReceiveOneData(u8 *receiveBuff, UART_HandleTypeDef *huart,float * angleset)
  63:Core/Src/data_cal.c **** {
  64:Core/Src/data_cal.c **** 
  65:Core/Src/data_cal.c **** 	unsigned char USART_Receiver = 0;		   // 接收数据
  66:Core/Src/data_cal.c **** 	static unsigned char checkSum = 0;		   // ？
  67:Core/Src/data_cal.c **** 	static unsigned char USARTBufferIndex = 0; // 串口索引
  68:Core/Src/data_cal.c **** 	static short j = 0, k = 0;
  69:Core/Src/data_cal.c **** 	static unsigned char USARTReceiverFront = 0;
  70:Core/Src/data_cal.c **** 	static unsigned char Start_Flag = START; // 一帧数据传送开始标志位
  71:Core/Src/data_cal.c **** 	static short dataLength = 0;
  72:Core/Src/data_cal.c **** 
  73:Core/Src/data_cal.c **** 	USART_Receiver = receiveBuff[1];
  74:Core/Src/data_cal.c **** 	USARTReceiverFront = receiveBuff[0];
  75:Core/Src/data_cal.c **** 
  76:Core/Src/data_cal.c **** 	// 接收消息头
  77:Core/Src/data_cal.c **** 	if (Start_Flag == START)
  78:Core/Src/data_cal.c **** 	{
  79:Core/Src/data_cal.c **** 		if (USART_Receiver == 0xaa) // buf[1]
  80:Core/Src/data_cal.c **** 		{
  81:Core/Src/data_cal.c **** 			if (USARTReceiverFront == 0x55) // 数据头两位 //buf[0]
  82:Core/Src/data_cal.c **** 			{
  83:Core/Src/data_cal.c **** 				Start_Flag = !START; // 收到数据头，开始接收数据
  84:Core/Src/data_cal.c **** 				// printf("header ok\n");
  85:Core/Src/data_cal.c **** 				receiveBuff[0] = header[0]; // buf[0]
  86:Core/Src/data_cal.c **** 				receiveBuff[1] = header[1]; // buf[1]
ARM GAS  D:\software\msy64\tmp\ccykZo4O.s 			page 3


  87:Core/Src/data_cal.c **** 				USARTBufferIndex = 0;		// 缓冲区初始化
  88:Core/Src/data_cal.c **** 				checkSum = 0x00;			// 校验和初始化
  89:Core/Src/data_cal.c **** 			}
  90:Core/Src/data_cal.c **** 		}
  91:Core/Src/data_cal.c **** 		else
  92:Core/Src/data_cal.c **** 		{
