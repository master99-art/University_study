 152:Core/Src/data_cal.c **** void usartSendData(UART_HandleTypeDef *huart)
 153:Core/Src/data_cal.c **** {
 154:Core/Src/data_cal.c **** 	// 协议数据缓存数组
 155:Core/Src/data_cal.c **** 	unsigned char buf[13] = {0};
 156:Core/Src/data_cal.c **** 	int i, length = 0;
 157:Core/Src/data_cal.c **** 	length = 13;
 158:Core/Src/data_cal.c **** 	// 计算joint角度
 159:Core/Src/data_cal.c **** 	joint11.d = (short)(joint1.now_angle / radio[0] * 1000.0);
 160:Core/Src/data_cal.c **** 	joint21.d = (short)(joint2.now_angle / radio[1] * 1000.0);
 161:Core/Src/data_cal.c **** 	joint31.d = (short)(joint3.now_angle / radio[2] * 1000.0);
 162:Core/Src/data_cal.c **** 	joint41.d = (short)(joint4.now_angle / radio[3] * 1000.0);
 163:Core/Src/data_cal.c **** 	joint51.d = (short)(joint5.now_angle / radio[4] * 1000.0);
 164:Core/Src/data_cal.c **** 	joint61.d = (short)(joint6.now_angle / radio[5] * 1000.0);
 165:Core/Src/data_cal.c **** 
 166:Core/Src/data_cal.c **** 	// joint11.d = (short)(1);
 167:Core/Src/data_cal.c **** 	// joint21.d = (short)(122);
 168:Core/Src/data_cal.c **** 	// joint31.d = (short)(1223);
 169:Core/Src/data_cal.c **** 	// joint41.d = (short)(1234);
 170:Core/Src/data_cal.c **** 	// joint51.d = (short)(145);
 171:Core/Src/data_cal.c **** 	// joint61.d = (short)(145);
 172:Core/Src/data_cal.c **** 	// 设置
 173:Core/Src/data_cal.c **** 	for (i = 0; i < 2; i++)
 174:Core/Src/data_cal.c **** 		buf[i] = header[i]; // buf[0] buf[1]
 175:Core/Src/data_cal.c **** 
 176:Core/Src/data_cal.c **** 	buf[2] = length; // buf[2]
 177:Core/Src/data_cal.c **** 	for (i = 0; i < 2; i++)
 178:Core/Src/data_cal.c **** 	{
 179:Core/Src/data_cal.c **** 		buf[i + 3] = joint11.data[i];  // buf[3]  buf[4]
 180:Core/Src/data_cal.c **** 		buf[i + 5] = joint21.data[i];  // buf[5]  buf[6]
 181:Core/Src/data_cal.c **** 		buf[i + 7] = joint31.data[i];  // buf[7]  buf[8]
 182:Core/Src/data_cal.c **** 		buf[i + 9] = joint41.data[i];  // buf[9]  buf[10]
 183:Core/Src/data_cal.c **** 		buf[i + 11] = joint51.data[i]; // buf[11] buf[12]
 184:Core/Src/data_cal.c **** 		buf[i + 13] = joint61.data[i]; // buf[13] buf[14]
 185:Core/Src/data_cal.c **** 	}
 186:Core/Src/data_cal.c **** 	// buf[i + 7] = 					   // buf[7] buf[8]// 预留控制指令
 187:Core/Src/data_cal.c **** 	buf[3 + length - 1] = (u8)hand.action; // 夹爪
 188:Core/Src/data_cal.c **** 
 189:Core/Src/data_cal.c **** 	// 设置校验值、消息尾
 190:Core/Src/data_cal.c **** 	buf[3 + length] = getCrc8(buf, 3 + length); // buf[10]
 191:Core/Src/data_cal.c **** 	buf[3 + length + 1] = ender[0];				// buf[11]
 192:Core/Src/data_cal.c **** 	buf[3 + length + 2] = ender[1];				// buf[12]
 193:Core/Src/data_cal.c **** 
 194:Core/Src/data_cal.c **** 	HAL_UART_Transmit(huart, (uint8_t *)buf, 19, 0xf);
 195:Core/Src/data_cal.c **** }
