 144:Core/Src/data_cal.c **** 				AngleSet[0] = ((float)joint1Set.d / 1000.0);
 145:Core/Src/data_cal.c **** 				AngleSet[1] = ((float)joint2Set.d / 1000.0);
 146:Core/Src/data_cal.c **** 				AngleSet[2] = ((float)joint3Set.d / 1000.0);
 147:Core/Src/data_cal.c **** 				AngleSet[3] = ((float)joint4Set.d / 1000.0);
 148:Core/Src/data_cal.c **** 				AngleSet[4] = ((float)joint5Set.d / 1000.0);
 149:Core/Src/data_cal.c **** 				AngleSet[5] = ((float)joint6Set.d / 1000.0);
 150:Core/Src/data_cal.c **** 				AngleSet[6] = (float)receiveBuff[15];
 151:Core/Src/data_cal.c **** 				//-----------------------------------------------------------------
 152:Core/Src/data_cal.c **** 				// 完成一个数据包的接收，相关变量清零，等待下一字节数据
 153:Core/Src/data_cal.c **** 				USARTBufferIndex = 0;
 154:Core/Src/data_cal.c **** 				USARTReceiverFront = 0;
 155:Core/Src/data_cal.c **** 				Start_Flag = START;
 156:Core/Src/data_cal.c **** 				checkSum = 0;
 157:Core/Src/data_cal.c **** 				dataLength = 0;
 158:Core/Src/data_cal.c **** 				j = 0;
 159:Core/Src/data_cal.c **** 				k = 0;
 160:Core/Src/data_cal.c **** 				//-----------------------------------------------------------------
 161:Core/Src/data_cal.c **** 			}
 162:Core/Src/data_cal.c **** 			break;
 163:Core/Src/data_cal.c **** 		default:
